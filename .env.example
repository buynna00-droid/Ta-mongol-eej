# ─────────────────────────────────────────────────────────────────────
# Та Монгол Ээж — орчны хувьсагчид (environment variables)
#
# 1. Энэ файлыг ".env" нэрээр хуулна:
#      macOS/Linux:  cp .env.example .env
#      Windows:      copy .env.example .env
# 2. Доорх утгуудыг өөрийн бодит утгаар солино.
# 3. Dev server-ээ дахин эхлүүлнэ (npm run dev).
#    Vercel / Netlify / GitHub Pages дээр эдгээр утгыг тухайн үйлчилгээний
#    Environment Variables хэсэгт оруулаад дахин deploy хийнэ (README.md).
#
# ⚠ VITE_ угтвартай утгууд build хийх үед вэбсайтын JavaScript-д шингэж,
#   хэн ч харах боломжтой болдог. Нууц үг, API түлхүүр энд БҮҮ оруул.
#   ".env" файл .gitignore-д орсон тул git-д commit хийгдэхгүй.
# ─────────────────────────────────────────────────────────────────────

# Бүртгэлийн маягт — Formspree-ийн form endpoint (README.md → 7. Бүртгэлийн маягт)
# YOUR_FORM_ID-г Formspree-ээс авсан өөрийн form ID-аар солино.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Зургийн цомгийн виджет — SociableKit эсвэл Elfsight-ийн embed код (README.md → 6)
# Кодыг бүтнээр нь (div + script) нэг мөрөнд оруулна.
#   • Код дотор давхар хашилт (") байвал гадуур нь дан хашилт тавина:  '…'
#   • Код дотор дан хашилт (') байвал гадуур нь давхар хашилт тавина:  "…"
# Хэлбэрийн жишээ (бодит код биш):
#   VITE_GALLERY_EMBED_CODE='<div class="…" data-…="…"></div><script src="https://…" defer></script>'
VITE_GALLERY_EMBED_CODE=
